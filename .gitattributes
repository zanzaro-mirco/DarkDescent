# ============================================================
#  Normalizzazione testo
# ============================================================
* text=auto

*.cs      text diff=csharp eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.asmdef  text eol=lf
*.asmref  text eol=lf
*.inputactions text eol=lf
*.shader  text eol=lf
*.hlsl    text eol=lf
*.cginc   text eol=lf
*.yml     text eol=lf
*.gitattributes text eol=lf
.gitignore      text eol=lf

# ============================================================
#  File Unity YAML: testo, ma con merge driver dedicato.
#  Richiede:  git config merge.unityyamlmerge.driver "<percorso UnityYAMLMerge.exe> merge -p %O %B %A %A"
# ============================================================
*.unity      merge=unityyamlmerge eol=lf
*.prefab     merge=unityyamlmerge eol=lf
*.asset      merge=unityyamlmerge eol=lf
*.mat        merge=unityyamlmerge eol=lf
*.anim       merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf
*.overrideController merge=unityyamlmerge eol=lf
*.physicMaterial     merge=unityyamlmerge eol=lf
*.meta       merge=unityyamlmerge eol=lf

# ============================================================
#  Git LFS — binari. Senza questo il repo diventa ingestibile.
# ============================================================
# Modelli 3D
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.FBX   filter=lfs diff=lfs merge=lfs -text
